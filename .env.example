# NEVER commit actual secrets. Sandbox-only. Copy to .env locally and keep it out of Git.
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=PASTE_SANDBOX_CLIENT_ID
PAYPAL_CLIENT_SECRET=PASTE_SANDBOX_SECRET
PAYPAL_WEBHOOK_ID=PASTE_SANDBOX_WEBHOOK_ID
SHOP_SUPABASE_URL=https://YOUR-TEST-PROJECT.supabase.co
SHOP_SUPABASE_SERVICE_ROLE_KEY=PASTE_TEST_SERVICE_ROLE_KEY
SHOP_SHIPPING_USD=0.00

# Etsy-like shop CRM (local testing only). BOT token never goes to frontend.
SHOP_CRM_TEST_MODE=1
# Optional overrides. Otherwise use the main site TG_BOT_TOKEN and TG_CHAT_ID.
SHOP_TG_BOT_TOKEN=
SHOP_TG_CHAT_ID=
# Optional numeric Telegram forum topic ID (omit for normal chats):
# SHOP_TG_TOPIC_ID=123

# Default local receipt transport uses Mailpit. Enable Resend only for delivery to real inboxes.
# SHOP_RECEIPT_TRANSPORT=resend
# SHOP_RESEND_API_KEY=
# SHOP_RECEIPT_FROM=
